# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Replicate Layout Plugin Log
replicate_layout.log
# Hugo documentation site
site/public/
site/resources/
site/.hugo_build.lock

# Generated design-check reports
*-erc.rpt
*-drc.rpt

# Hand-maintained LCSC part assignments: an input to the BOM/CPL tools, not an export
!tools/lcsc-parts.csv

# Firmware build output (arduino-cli --build-path)
software/build/

# Python bytecode caches
__pycache__/
*.pyc

# JLCPCB upload staging: duplicates of files already under production/
production/upload/
