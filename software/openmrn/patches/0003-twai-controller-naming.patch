+// --- FemtoLCC patch: TWAI peripheral naming --------------------------------
+//
+// SoCs with a single TWAI controller (ESP32, S2, S3, C3) name its peripheral,
+// interrupt and GPIO matrix signals TWAI_*. SoCs with two (ESP32-C6, and the
+// P4) number them, so the same things are TWAI0_*. This driver only ever drives
+// the first controller, so selecting the names on the controller count keeps
+// both kinds of SoC working and leaves the generated code identical on the
+// single-controller parts.
+#if defined(SOC_TWAI_CONTROLLER_NUM) && SOC_TWAI_CONTROLLER_NUM > 1
+#define OPENMRN_PERIPH_TWAI_MODULE  PERIPH_TWAI0_MODULE
+#define OPENMRN_ETS_TWAI_INTR_SOURCE ETS_TWAI0_INTR_SOURCE
+#define OPENMRN_TWAI_TX_IDX         TWAI0_TX_IDX
+#define OPENMRN_TWAI_RX_IDX         TWAI0_RX_IDX
+#define OPENMRN_TWAI_CLKOUT_IDX     TWAI0_CLKOUT_IDX
+#define OPENMRN_TWAI_BUS_OFF_ON_IDX TWAI0_BUS_OFF_ON_IDX
+#else
+#define OPENMRN_PERIPH_TWAI_MODULE  PERIPH_TWAI_MODULE
+#define OPENMRN_ETS_TWAI_INTR_SOURCE ETS_TWAI_INTR_SOURCE
+#define OPENMRN_TWAI_TX_IDX         TWAI_TX_IDX
+#define OPENMRN_TWAI_RX_IDX         TWAI_RX_IDX
+#define OPENMRN_TWAI_CLKOUT_IDX     TWAI_CLKOUT_IDX
+#define OPENMRN_TWAI_BUS_OFF_ON_IDX TWAI_BUS_OFF_ON_IDX
+#endif
+// --- end patch --------------------------------------------------------------
+
 namespace openmrn_arduino
 {
 
